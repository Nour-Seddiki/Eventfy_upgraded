# Copy to backend/.env and fill in. Never commit the real .env.

# ── Auth ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (Supabase PostgreSQL pooler) ──
DB_HOST=
DB_PORT=6543
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# ── Supabase Storage (event images, avatars) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Email (SMTP, or Resend if RESEND_API_KEY is set) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
RESEND_API_KEY=

# ── Google sign-in ──
GOOGLE_CLIENT_ID=

# ── Chargily Pay (EDAHABIA / CIB) ──
# Secret key from the Chargily dashboard (test_sk_... in test mode). It
# authenticates API calls and signs webhooks; payments are disabled without it.
CHARGILY_SECRET=
CHARGILY_KEY=
# Test mode; for live payments use https://pay.chargily.net/api/v2/
CHARGILY_URL=https://pay.chargily.net/test/api/v2/
# Public URL of this backend; Chargily posts webhooks to $BACKEND_URL/payment/webhook.
# Leave empty to use the webhook URL set in the Chargily dashboard.
BACKEND_URL=

# Frontend origin(s), comma-separated; used for CORS and payment redirect URLs
FRONTEND_URL=http://localhost:5500
